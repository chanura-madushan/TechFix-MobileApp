<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvServiceName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Service Name"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvServicePrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rs. 0.00"
        android:textSize="18sp"
        android:textColor="#1976D2"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preferred Date (yyyy-mm-dd)"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/etDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="2026-08-20"
        android:inputType="date"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvBranchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap 'Find Nearest Branch' to detect your location"
        android:textSize="14sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnFindBranch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find Nearest Branch" />

    <Button
        android:id="@+id/btnConfirmBooking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Confirm Booking"
        android:layout_marginTop="12dp"
        android:enabled="false" />

</LinearLayout>