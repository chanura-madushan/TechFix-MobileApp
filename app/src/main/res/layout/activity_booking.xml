<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvServiceName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Service Name"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvServicePrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Rs. 0.00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/accent"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Preferred Date (yyyy-mm-dd)"
        android:textSize="14sp"
        android:textColor="@color/text_secondary" />

    <EditText
        android:id="@+id/etDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="2026-08-20"
        android:inputType="date"
        android:textColor="@color/text_primary"
        android:background="@drawable/bg_edittext"
        android:layout_marginTop="6dp"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvBranchStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tap 'Find Nearest Branch' to detect your location"
        android:textSize="14sp"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnFindBranch"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Find Nearest Branch"
        android:textColor="@color/primary"
        android:textStyle="bold"
        android:background="@drawable/bg_button_outline" />

    <Button
        android:id="@+id/btnConfirmBooking"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Confirm Booking"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:background="@drawable/bg_button_accent"
        android:layout_marginTop="12dp"
        android:enabled="false" />

</LinearLayout>